{
  "name": "question-paper-bank",
  "version": "1.0.0",
  "private": true,
  "description": "Question Paper Bank & Examination Paper Management System (SRS v1.0)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && (if [ -n \"$DIRECT_URL\" ]; then tsx prisma/deploy.ts && tsx prisma/seed.ts; else echo 'No DIRECT_URL set: frontend-only build, skipping database setup'; fi) && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx prisma/deploy.ts",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "tsx prisma/deploy.ts && tsx prisma/seed.ts",
    "setup:demo": "tsx prisma/deploy.ts && tsx prisma/seed.ts --demo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tiptap/extension-placeholder": "2.9.1",
    "@tiptap/extension-subscript": "2.9.1",
    "@tiptap/extension-superscript": "2.9.1",
    "@tiptap/extension-table": "2.9.1",
    "@tiptap/extension-table-cell": "2.9.1",
    "@tiptap/extension-table-header": "2.9.1",
    "@tiptap/extension-table-row": "2.9.1",
    "@tiptap/extension-text-align": "2.9.1",
    "@tiptap/extension-underline": "2.9.1",
    "@tiptap/pm": "2.9.1",
    "@tiptap/react": "2.9.1",
    "@tiptap/starter-kit": "2.9.1",
    "bcryptjs": "2.4.3",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "lucide-react": "0.453.0",
    "next": "14.2.15",
    "nodemailer": "6.9.16",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/nodemailer": "6.4.16",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/sanitize-html": "2.13.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
