# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Supabase). Use the Supavisor pooler — Supabase's direct host is IPv6-only.
# Transaction mode (port 6543) for the app, session mode (port 5432) for schema pushes.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Session signing secret — long random string (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Encrypts CNICs at rest (AES-256-GCM). REQUIRED: 32 random bytes, base64 — UI3hs4J4rlzOUj3nHQaqM2RfZZUDY3pQCK/9sGNm404=.
# Store it with your backup secrets: if it is lost, stored CNICs cannot be read. Never change it
# on a live database (there is no re-encryption step yet).
DATA_ENCRYPTION_KEY=""

# Set to true for ONE deploy, after taking a database backup, to apply pending migrations to a
# database that already holds data (prisma/deploy.ts refuses otherwise). Remove it afterwards.
MIGRATE_EXISTING_DB=""

# Private file repository. With both Supabase values set, files go to a private
# Supabase Storage bucket; otherwise to the local STORAGE_DIR.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="papers"
STORAGE_DIR="./storage"
# Vercel limits request bodies to 4.5 MB.
MAX_UPLOAD_MB=4

# First Controller account, created by the seed when none exists (production).
CONTROLLER_EMAIL=""
INITIAL_CONTROLLER_PASSWORD=""
CURRENT_SEMESTER="Fall 2026"
INSTITUTION_NAME="Examinations Department"

# FR-27/28 integration API (/api/v1/integration/*): create one key per external system in
# Controller -> Settings -> Integration API keys. Sent as the "x-api-key" header.
# Deprecated: a single shared key, still accepted for every module until you remove it.
INTEGRATION_API_KEY=""

# Protects the scheduled jobs (/api/cron/*). Vercel Cron sends it automatically as a Bearer
# token when this variable is set in the project. Empty = scheduled jobs disabled.
CRON_SECRET=""

# Optional SMTP for password-reset OTP emails. If unset, the OTP is printed to the
# server log only — it is never returned to the browser.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Examinations Office <no-reply@example.edu>"
