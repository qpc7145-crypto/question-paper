# Copy to .env and adjust.

# SQLite for local development. For production switch prisma/schema.prisma
# provider to "postgresql" and use e.g. postgresql://user:pass@host:5432/qpbank
DATABASE_URL="file:./dev.db"

# Session signing secret — use a long random string (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Secure file repository (outside /public; files are only served through access-checked API streams)
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=20

# FR-27/28 integration API (/api/v1/integration/*). Leave empty to disable.
# Clients send it as the "x-api-key" header.
INTEGRATION_API_KEY=""

# Optional SMTP for password-reset OTP emails. If unset, the OTP is printed to the
# server console (development only) — it is never returned to the browser.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Examinations Office <no-reply@example.edu>"
